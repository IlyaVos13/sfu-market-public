<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="urn:sfu-market:processes">
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane0" name="Продавец">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="Модератор чата">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane2" name="Покупатель">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane3" name="Стороны сделки">
        <bpmn:flowNodeRef>agree</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="">
      <bpmn:outgoing>a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="prepare" name="Подготовить текст и фотографии">
      <bpmn:incoming>a1</bpmn:incoming>
      <bpmn:outgoing>a2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="post" name="Разместить в чате">
      <bpmn:incoming>a2</bpmn:incoming>
      <bpmn:outgoing>a3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="messageAssoc">
        <bpmn:targetRef>message</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="review" name="Проверить правила вручную">
      <bpmn:incoming>a3</bpmn:incoming>
      <bpmn:outgoing>a4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="read" name="Просмотреть ленту и найти вещь">
      <bpmn:incoming>a4</bpmn:incoming>
      <bpmn:outgoing>a5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ask" name="Уточнить цену и наличие">
      <bpmn:incoming>a5</bpmn:incoming>
      <bpmn:outgoing>a6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="answer" name="Ответить покупателю">
      <bpmn:incoming>a6</bpmn:incoming>
      <bpmn:outgoing>a7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="agree" name="Согласовать передачу">
      <bpmn:incoming>a7</bpmn:incoming>
      <bpmn:outgoing>a8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="remove" name="Обновить сообщения вручную">
      <bpmn:incoming>a8</bpmn:incoming>
      <bpmn:outgoing>a9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e" name="">
      <bpmn:incoming>a9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="a1" sourceRef="s" targetRef="prepare" name=""/>
    <bpmn:sequenceFlow id="a2" sourceRef="prepare" targetRef="post" name=""/>
    <bpmn:sequenceFlow id="a3" sourceRef="post" targetRef="review" name=""/>
    <bpmn:sequenceFlow id="a4" sourceRef="review" targetRef="read" name="допущено"/>
    <bpmn:sequenceFlow id="a5" sourceRef="read" targetRef="ask" name=""/>
    <bpmn:sequenceFlow id="a6" sourceRef="ask" targetRef="answer" name="вопросы"/>
    <bpmn:sequenceFlow id="a7" sourceRef="answer" targetRef="agree" name=""/>
    <bpmn:sequenceFlow id="a8" sourceRef="agree" targetRef="remove" name=""/>
    <bpmn:sequenceFlow id="a9" sourceRef="remove" targetRef="e" name=""/>
    <bpmn:dataObject id="messageObj"/>
    <bpmn:dataObjectReference id="message" dataObjectRef="messageObj" name="Сообщение&#10;в ленте"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="Процесс работы с объявлением" processRef="Process"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="PoolDI" bpmnElement="Pool">
        <dc:Bounds x="0" y="60" width="1190" height="1320"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane0DI" bpmnElement="Lane0">
        <dc:Bounds x="10" y="70" width="295" height="1310"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane1DI" bpmnElement="Lane1">
        <dc:Bounds x="305" y="70" width="295" height="1310"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane2DI" bpmnElement="Lane2">
        <dc:Bounds x="600" y="70" width="295" height="1310"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane3DI" bpmnElement="Lane3">
        <dc:Bounds x="895" y="70" width="295" height="1310"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="a1DI" bpmnElement="a1">
        <di:waypoint x="157" y="185"/>
        <di:waypoint x="157" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a2DI" bpmnElement="a2">
        <di:waypoint x="157" y="330"/>
        <di:waypoint x="157" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a3DI" bpmnElement="a3">
        <di:waypoint x="267" y="485"/>
        <di:waypoint x="342" y="485"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a4DI" bpmnElement="a4">
        <di:waypoint x="452" y="530"/>
        <di:waypoint x="452" y="610"/>
        <di:waypoint x="747" y="610"/>
        <di:waypoint x="747" y="650"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a5DI" bpmnElement="a5">
        <di:waypoint x="747" y="740"/>
        <di:waypoint x="747" y="840"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a6DI" bpmnElement="a6">
        <di:waypoint x="637" y="885"/>
        <di:waypoint x="267" y="885"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a7DI" bpmnElement="a7">
        <di:waypoint x="157" y="930"/>
        <di:waypoint x="157" y="1000"/>
        <di:waypoint x="1042" y="1000"/>
        <di:waypoint x="1042" y="1040"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a8DI" bpmnElement="a8">
        <di:waypoint x="1042" y="1130"/>
        <di:waypoint x="1042" y="1170"/>
        <di:waypoint x="157" y="1170"/>
        <di:waypoint x="157" y="1210"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a9DI" bpmnElement="a9">
        <di:waypoint x="157" y="1290"/>
        <di:waypoint x="157" y="1320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="sDI" bpmnElement="s">
        <dc:Bounds x="137" y="145" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prepareDI" bpmnElement="prepare">
        <dc:Bounds x="47" y="240" width="220" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="postDI" bpmnElement="post">
        <dc:Bounds x="47" y="440" width="220" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewDI" bpmnElement="review">
        <dc:Bounds x="342" y="440" width="220" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="readDI" bpmnElement="read">
        <dc:Bounds x="637" y="650" width="220" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="askDI" bpmnElement="ask">
        <dc:Bounds x="637" y="840" width="220" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answerDI" bpmnElement="answer">
        <dc:Bounds x="47" y="840" width="220" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="agreeDI" bpmnElement="agree">
        <dc:Bounds x="932" y="1040" width="220" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="removeDI" bpmnElement="remove">
        <dc:Bounds x="47" y="1210" width="220" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eDI" bpmnElement="e">
        <dc:Bounds x="137" y="1320" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="messageDI" bpmnElement="message">
        <dc:Bounds x="637" y="440" width="220" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="messageAssocDI" bpmnElement="messageAssoc">
        <di:waypoint x="267" y="455"/>
        <di:waypoint x="290" y="455"/>
        <di:waypoint x="290" y="400"/>
        <di:waypoint x="747" y="400"/>
        <di:waypoint x="747" y="440"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
